<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ W }}, height={{ H }}" />
    <!-- generated by reelforge from {{ project_file }} -- edit the project, not this file -->
    <script src="{{ gsap }}"></script>
    <style>
{{ css }}
      html, body { width: {{ W }}px; height: {{ H }}px; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="{{ duration }}" data-width="{{ W }}" data-height="{{ H }}" data-fps="{{ fps }}"{% if motion_blur %} data-motion-blur="on"{% endif %}>
      <div id="ground" class="clip" data-start="0" data-duration="{{ duration }}" data-track-index="0"></div>
      {%- for s in scenes %}
      <div id="{{ s.id }}" data-composition-id="{{ s.id }}" data-composition-src="compositions/{{ s.id }}.html" data-start="{{ s.start }}" data-duration="{{ s.duration }}" data-track-index="1" data-track-kind="graphics" data-width="{{ W }}" data-height="{{ H }}" style="z-index:2"></div>
      {%- endfor %}
      {%- if captions %}
      <div id="captions" data-composition-id="captions" data-composition-src="compositions/captions.html" data-start="0" data-duration="{{ duration }}" data-track-index="2" data-track-kind="captions" data-width="{{ W }}" data-height="{{ H }}" style="z-index:5"></div>
      {%- endif %}
      <!-- AUDIO -->
      <!-- /AUDIO -->
    </div>
    <script>
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = gsap.timeline({ paused: true });
    </script>
  </body>
</html>
