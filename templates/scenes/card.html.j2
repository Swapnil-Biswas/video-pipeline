{% import "_lib.j2" as lib with context %}
{#- Clay UI card beat (original: held / gate / choice / crew).
    s.heading: "Every step [checked.]"   s.heading_size: 92
    s.card: { dark: bool, width: 820, icon: "AB" | image path, title, subtitle, amount,
              rows: [{label, value, state: released|held|refunded|<text>, strike: bool, icon: check|x}],
              buttons: ["Dispute · refund", "Accept · pay"], hover: 0, click: 1, result: "Released",
              stamp: "BLOCKED" }
    The cursor is placed inside the clicked button's wrapper, so it always lands on it whatever the layout. -#}
{%- set c = s.card or {} -%}
{%- set dark_world = s.world == 'dark' -%}
{%- set dark = c.dark if c.dark is defined else dark_world -%}
{%- set d = s.duration -%}
{%- set nrows = (c.rows or [])|length -%}
{%- set t_rows = 0.36 -%}
{%- set t_cur = t_rows + nrows * 0.15 + 0.05 -%}
{%- set t_click = t_cur + (0.75 if c.hover is not none and c.hover is defined else 0.4) -%}
<template>
  <style>
    #{{ id }}-root { position: absolute; inset: 0; overflow: hidden; }
    #{{ id }}-cam { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: {{ (44*u)|round }}px; }
    #{{ id }}-h { position: relative; font-family: {{ T.font_display }};{% if T.display_upper %} text-transform: uppercase;{% endif %}  max-width: {{ (W*0.9)|round }}px; text-align: center; font-weight: 700; letter-spacing: -0.04em; line-height: 1.04; font-size: {{ ((s.heading_size or 92)*u)|round }}px; color: {{ T.on_dark if dark_world else T.on_light }}; }
    #{{ id }}-h .w { display: inline-block; margin-right: 0.2em; }
    #{{ id }}-h .w:last-child { margin-right: 0; }
    #{{ id }}-card { position: relative; width: {{ ([((c.width or 820)*u), W*0.9]|min)|round }}px; border-radius: {{ (44*u)|round }}px; padding: {{ (38*u)|round }}px {{ (42*u)|round }}px; display: grid; gap: {{ (14*u)|round }}px;
      {% if dark %}background: {{ T.card_dark }}; color: {{ T.light_row }}; box-shadow: 0 40px 70px -30px rgba(0,0,0,.9), inset 5px 5px 12px rgba(255,255,255,.06), inset -8px -8px 16px rgba(0,0,0,.5);{% endif %} }
    #{{ id }}-card .ttl { display: flex; align-items: center; gap: {{ (18*u)|round }}px; font-size: {{ (40*u)|round }}px; font-weight: 700; }
    #{{ id }}-card .ico { width: {{ (68*u)|round }}px; height: {{ (68*u)|round }}px; border-radius: 30%; display: grid; place-items: center; font-size: {{ (28*u)|round }}px; font-weight: 700; flex: none; overflow: hidden; background: #000; color: #fff; box-shadow: 0 0 0 2px rgba(255,255,255,.18); }
    #{{ id }}-card .ico img { width: 100%; height: 100%; display: block; }
    #{{ id }}-card .sub { font-size: {{ (30*u)|round }}px; font-weight: 600; color: {{ T.on_dark_2 if dark else T.on_light_2 }}; }
    #{{ id }}-card .amt { font-size: {{ (130*u)|round }}px; font-weight: 700; letter-spacing: -0.05em; line-height: 1; }
    #{{ id }}-card .row { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: {{ (16*u)|round }}px; padding: {{ (14*u)|round }}px {{ (16*u)|round }}px {{ (14*u)|round }}px {{ (22*u)|round }}px; border-radius: {{ (24*u)|round }}px; font-size: {{ (32*u)|round }}px; font-weight: 600;
      background: {{ T.card_dark_2 if dark else T.light_row }}; }
    #{{ id }}-card .row .v { font-weight: 700; text-align: right; }
    #{{ id }}-card .row.strike .lbl { text-decoration: line-through; text-decoration-thickness: 3px; color: {{ T.on_dark_2 }}; }
    #{{ id }}-card .row .state { font-size: {{ (28*u)|round }}px; min-width: {{ (150*u)|round }}px; padding: {{ (6*u)|round }}px {{ (16*u)|round }}px; }
    #{{ id }}-card .row .mk { width: {{ (34*u)|round }}px; height: {{ (34*u)|round }}px; }
    #{{ id }}-card .btns { display: grid; grid-template-columns: repeat({{ (c.buttons or [1])|length }}, 1fr); gap: {{ (20*u)|round }}px; margin-top: {{ (8*u)|round }}px; }
    #{{ id }}-card .bw { position: relative; }
    #{{ id }}-card .b { position: relative; overflow: hidden; height: {{ (100*u)|round }}px; border-radius: 999px; display: grid; place-items: center; font-size: {{ (32*u)|round }}px; font-weight: 700; }
    #{{ id }}-card .fill { position: absolute; inset: 0; background: {{ T.accent }}; border-radius: 999px; transform-origin: 0 50%; }
    #{{ id }}-card .bt { position: relative; }
    #{{ id }}-card .rf-cursor { left: 55%; top: 52%; width: {{ (64*u)|round }}px; height: {{ (76*u)|round }}px; }
    #{{ id }}-res { position: absolute; right: {{ (-18*u)|round }}px; top: {{ (-26*u)|round }}px; font-size: {{ (30*u)|round }}px; }
    #{{ id }}-stamp { position: absolute; right: {{ (30*u)|round }}px; bottom: {{ (30*u)|round }}px; padding: {{ (12*u)|round }}px {{ (32*u)|round }}px; border-radius: {{ (22*u)|round }}px; font-size: {{ (72*u)|round }}px; font-weight: 700; letter-spacing: 0.04em; color: {{ T.on_light }}; background: {{ T.paper }}; box-shadow: 0 30px 50px -20px rgba(0,0,0,.8); }
    #{{ id }}-flash { position: absolute; inset: 0; background: {{ T.paper }}; opacity: 0; pointer-events: none; }
  </style>
  <div id="{{ id }}-root" data-composition-id="{{ id }}" data-width="{{ W }}" data-height="{{ H }}" data-layout-allow-overlap>
    {{ lib.world(s.world or 'light', id) }}
    <div id="{{ id }}-cam" data-layout-allow-overflow>
      {%- if s.heading %}
      <p id="{{ id }}-h">{{ lib.words(s.heading, dark_world) }}</p>
      {%- endif %}
      <div id="{{ id }}-card" class="{{ '' if dark else 'clay clay--surface' }}">
        {%- if c.title %}
        <div class="ttl">{% if c.icon %}<span class="ico" data-layout-ignore>{% if '.' in c.icon %}<img src="{{ c.icon }}" alt="" />{% else %}{{ c.icon }}{% endif %}</span>{% endif %}{{ c.title }}</div>
        {%- endif %}
        {%- if c.subtitle %}<div class="sub">{{ c.subtitle }}</div>{% endif %}
        {%- if c.amount %}<div class="amt">{{ c.amount }}</div>{% endif %}
        {%- for r in (c.rows or []) %}
        <div class="row{% if r.strike %} strike{% endif %}" id="{{ id }}-r{{ loop.index0 }}">
          {%- if r.icon == 'x' %}<span class="mk" style="border-radius:50%;box-shadow:inset 0 0 0 3px {{ T.on_dark if dark else T.on_light_2 }}"></span>{% elif r.icon %}<span class="tick {{ 'tick--light' if dark else '' }}"></span>{% else %}<span></span>{% endif %}
          <span class="lbl">{{ r.label }}</span><span class="v">{{ r.value or '' }}</span>
          {%- if r.state %}<span class="state {% if r.state in ['released','held','refunded'] %}state--{{ r.state }}{% endif %}"{% if r.state == 'refunded' and dark %} style="color:{{ T.light_row }};box-shadow: inset 0 0 0 3px {{ T.on_dark_2 }}"{% endif %}>{{ r.state_label or r.state|capitalize }}</span>{% else %}<span></span>{% endif %}
        </div>
        {%- endfor %}
        {%- if c.buttons %}
        <div class="btns">
          {%- for b in c.buttons %}
          <div class="bw"><span class="b btn--light" id="{{ id }}-b{{ loop.index0 }}">{% if loop.index0 == c.click %}<span class="fill" id="{{ id }}-fill"></span>{% endif %}<span class="bt" id="{{ id }}-bt{{ loop.index0 }}">{{ b }}</span></span>
            {%- if loop.index0 == c.click %}{{ lib.cursor(id ~ '-cur') }}{% endif %}</div>
          {%- endfor %}
        </div>
        {%- endif %}
        {%- if c.result %}<span id="{{ id }}-res" class="state state--released">{{ c.result }}</span>{% endif %}
        {%- if c.stamp %}<div id="{{ id }}-stamp">{{ c.stamp }}</div>{% endif %}
      </div>
    </div>
    <div id="{{ id }}-flash"></div>
  </div>
  <script>
    (function () {
      const tl = gsap.timeline({ paused: true });
{{ lib.entry_js(s.entry or 'blur', id ~ '-cam', id ~ '-flash') }}
      tl.fromTo("#{{ id }}-card", { scale: 0.8, y: {{ (90*u)|round }}, opacity: 0, filter: "blur(14px)" }, { scale: 1, y: 0, opacity: 1, filter: "blur(0px)", duration: 0.4, ease: "expo.out" }, 0.04);
      {%- if s.heading %}
      {%- if has_plain(s.heading) %}
      tl.fromTo("#{{ id }}-h .w:not(.acc)", { opacity: 0, filter: "blur(10px)" }, { opacity: 1, filter: "blur(0px)", duration: 0.14, stagger: 0.07, ease: "power2.out" }, 0.1);
      {%- endif %}{% if '[' in s.heading %}
      tl.fromTo("#{{ id }}-h .acc", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2.4)" }, 0.26);
      {%- endif %}{%- if '[' in s.heading %}{{ cue('pop-hi', s.start + 0.3, 0.55) }}{% endif %}
      {%- endif %}
      {%- for r in (c.rows or []) %}
      tl.fromTo("#{{ id }}-r{{ loop.index0 }}", { opacity: 0, x: {{ (-46*u)|round }} }, { opacity: 1, x: 0, duration: 0.24, ease: "expo.out" }, {{ t_rows + loop.index0 * 0.15 }});
      {%- if r.state %}
      tl.fromTo("#{{ id }}-r{{ loop.index0 }} .state", { scale: 0.6 }, { scale: 1, duration: 0.25, ease: "back.out(2.4)" }, {{ t_rows + loop.index0 * 0.15 + 0.06 }});
      {%- endif %}{{ cue('click-soft', s.start + t_rows + loop.index0 * 0.15 + 0.05, 0.5) }}
      {%- endfor %}
      {%- if c.stamp %}{% set ts = t_rows + nrows * 0.15 + 0.1 %}
      tl.fromTo("#{{ id }}-stamp", { opacity: 0, scale: 2.6, rotation: -16 }, { opacity: 1, scale: 1, rotation: -8, duration: 0.18, ease: "power4.in" }, {{ ts }});
      tl.fromTo("#{{ id }}-cam", { x: 0, y: 0 }, { keyframes: [{ x: -14, y: 8 }, { x: 12, y: -6 }, { x: -6, y: 4 }, { x: 0, y: 0 }], duration: 0.24, ease: "none", immediateRender: false }, {{ ts + 0.18 }});
      {{- cue('stamp', s.start + ts + 0.18, 0.6) }}
      {%- endif %}
      {%- if c.buttons and c.click is not none and c.click is defined %}
      // cursor flies in (from the lower right, off-frame), weighs up the hover button, commits to the click button
      {%- set nb = c.buttons|length %}{% set inner = ([((c.width or 820)*u), W*0.9]|min) - 84*u %}{% set bw = (inner - 20*u*(nb-1)) / nb %}
      {%- if c.hover is not none and c.hover is defined %}
      tl.fromTo("#{{ id }}-cur", { x: {{ (W*0.6)|round }}, y: {{ (H*0.5)|round }}, opacity: 0 }, { x: {{ ((c.hover - c.click) * (bw + 20*u))|round }}, y: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, {{ t_cur }});
      tl.to("#{{ id }}-b{{ c.hover }}", { scale: 1.04, duration: 0.15, ease: "power2.out" }, {{ t_cur + 0.37 }});
      tl.to("#{{ id }}-b{{ c.hover }}", { scale: 1, duration: 0.15 }, {{ t_cur + 0.55 }});
      tl.to("#{{ id }}-cur", { x: 0, duration: 0.3, ease: "power2.inOut" }, {{ t_cur + 0.45 }});
      {%- else %}
      tl.fromTo("#{{ id }}-cur", { x: {{ (W*0.6)|round }}, y: {{ (H*0.5)|round }}, opacity: 0 }, { x: 0, y: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, {{ t_cur }});
      {%- endif %}
      tl.to("#{{ id }}-cur", { scale: 0.85, duration: 0.07, yoyo: true, repeat: 1 }, {{ t_click }});
      tl.to("#{{ id }}-b{{ c.click }}", { scale: 0.94, duration: 0.07, yoyo: true, repeat: 1 }, {{ t_click }});
      tl.fromTo("#{{ id }}-fill", { scaleX: 0 }, { scaleX: 1, duration: 0.22, ease: "power3.out" }, {{ t_click + 0.04 }});
      tl.to("#{{ id }}-bt{{ c.click }}", { color: "{{ T.on_dark }}", duration: 0.12 }, {{ t_click + 0.06 }});
      {{- cue('click', s.start + t_click, 1.0) }}{{ cue('key-press', s.start + t_click, 0.8) }}{{ cue('pop-lo', s.start + t_click + 0.02, 0.7) }}{{ duck(s.start + t_click) }}
      {%- if c.result %}
      tl.fromTo("#{{ id }}-res", { opacity: 0, scale: 0.3 }, { opacity: 1, scale: 1, duration: 0.25, ease: "back.out(2.4)" }, {{ t_click + 0.13 }});
      {{- cue('pop-hi', s.start + t_click + 0.16, 0.6) }}
      {%- endif %}
      {%- elif c.result %}
      tl.fromTo("#{{ id }}-res", { opacity: 0, scale: 0.3 }, { opacity: 1, scale: 1, duration: 0.25, ease: "back.out(2.4)" }, {{ t_cur }});
      {%- endif %}
      tl.fromTo("#{{ id }}-cam", { scale: 1 }, { scale: 1.04, duration: {{ d - (1.45 if s.entry == 'flash' else 0.6) - 0.0 }}, ease: "none", immediateRender: false }, {{ 1.25 if s.entry == 'flash' else 0.4 }});
{{ lib.exit_js(s.exit or 'blur', id ~ '-cam', id ~ '-flash', d) }}
      window.__timelines["{{ id }}"] = tl;
    })();
  </script>
</template>
