{#- Shared scene grammar, distilled from the HireCrew showreel compositions.
    Every template gets: s (scene config), W, H, u (= min(W,H)/1080 scale unit), id, cue(file, t, vol). -#}

{% macro world(kind, id) -%}
{% if kind == 'dark' -%}
<div class="world-dark"></div>
<div class="glow" style="left:{{ (W/2 - 500*u)|round }}px;top:{{ (H/2 - 520*u)|round }}px;width:{{ (1000*u)|round }}px;height:{{ (1000*u)|round }}px"></div>
{%- else -%}
<div class="world-light"></div>
<div class="dotgrid dotgrid--light" data-layout-ignore></div>
{%- endif %}
{%- endmacro %}

{#- words("Pay only for [finished work.]") -> spans; [..] becomes the accent pill -#}
{% macro words(text, light_acc=false) -%}
{%- for w, acc in split_words(text) -%}
<span class="w{% if acc %} acc{% if light_acc %} acc--light{% endif %}{% endif %}">{{ w }}</span>
{%- endfor -%}
{%- endmacro %}

{#- JS: entry transition on the scene camera; emits its sound cue -#}
{% macro entry_js(kind, cam, flash_id) -%}
{%- if kind == 'flash' -%}{% if s.type == 'footage' %}{{ cue('whoosh-hi', s.start, 0.35) }}{% endif %}
      tl.fromTo("#{{ flash_id }}", { opacity: {{ 0.85 if s.type == 'footage' else 1 }} }, { opacity: 0, duration: {{ 0.22 if s.type == 'footage' else 0.18 }}, ease: "power2.out" }, 0);
      tl.fromTo("#{{ cam }}", { scale: 1.12 }, { scale: 1.0, duration: {{ [1.2, s.duration - 0.35]|min }}, ease: "expo.out" }, 0);
{%- elif kind == 'whip-left' -%}{{ cue('whoosh', s.start, 0.55) }}
      tl.fromTo("#{{ cam }}", { x: {{ (W*0.55)|round }}, filter: "blur(22px)" }, { x: 0, filter: "blur(0px)", duration: 0.3, ease: "expo.out" }, 0);
{%- elif kind == 'whip-right' -%}{{ cue('whoosh', s.start, 0.55) }}
      tl.fromTo("#{{ cam }}", { x: {{ (-W*0.55)|round }}, filter: "blur(22px)" }, { x: 0, filter: "blur(0px)", duration: 0.3, ease: "expo.out" }, 0);
{%- elif kind == 'push-up' -%}{{ cue('whoosh-short', s.start, 0.5) }}
      tl.fromTo("#{{ cam }}", { y: {{ (H*0.9)|round }}, filter: "blur(22px)" }, { y: 0, filter: "blur(0px)", duration: 0.3, ease: "expo.out" }, 0);
{%- elif kind == 'punch' -%}{{ cue('whoosh-short', s.start, 0.32) }}
      tl.fromTo("#{{ cam }}", { scale: 1.16 }, { scale: 1, duration: 0.26, ease: "power3.out" }, 0);
{%- elif kind == 'zoom-blur' -%}{{ cue('whoosh', s.start + 0.02, 0.42) }}
      tl.fromTo("#{{ cam }}", { scale: 1.32, filter: "blur(16px)", opacity: 0.4 }, { scale: 1, filter: "blur(0px)", opacity: 1, duration: 0.32, ease: "expo.out" }, 0);
{%- elif kind == 'shake' -%}{{ cue('impact-bass-1', s.start, 0.35) }}
      tl.fromTo("#{{ cam }}", { x: 0, y: 0 }, { keyframes: [{ x: -16, y: 9 }, { x: 13, y: -7 }, { x: -7, y: 4 }, { x: 0, y: 0 }], duration: 0.26, ease: "none" }, 0);
{%- elif kind == 'blur' -%}
      tl.fromTo("#{{ cam }}", { scale: 1.12, opacity: 0, filter: "blur(16px)" }, { scale: 1, opacity: 1, filter: "blur(0px)", duration: 0.34, ease: "expo.out" }, 0);
{%- endif -%}
{%- endmacro %}

{#- JS: exit transition, timed so it ends at the scene end -#}
{% macro exit_js(kind, cam, flash_id, d) -%}
{%- if kind == 'whip-left' -%}{{ cue('whoosh', s.start + d - 0.22, 0.55) }}
      tl.to("#{{ cam }}", { x: {{ (-W*0.9)|round }}, filter: "blur(22px)", duration: 0.24, ease: "power3.in" }, {{ d - 0.24 }});
{%- elif kind == 'whip-right' -%}{{ cue('whoosh', s.start + d - 0.22, 0.55) }}
      tl.to("#{{ cam }}", { x: {{ (W*0.9)|round }}, filter: "blur(22px)", duration: 0.24, ease: "power3.in" }, {{ d - 0.24 }});
{%- elif kind == 'up' -%}{{ cue('whoosh-short', s.start + d - 0.22, 0.5) }}
      tl.to("#{{ cam }}", { y: {{ (-H*1.1)|round }}, filter: "blur(22px)", duration: 0.24, ease: "power3.in" }, {{ d - 0.24 }});
{%- elif kind == 'blur' -%}
      tl.to("#{{ cam }}", { scale: 0.9, opacity: 0, filter: "blur(18px)", duration: 0.2, ease: "power3.in" }, {{ d - 0.2 }});
{%- elif kind == 'zoom' -%}
      tl.to("#{{ cam }}", { scale: 1.3, opacity: 0, filter: "blur(18px)", duration: 0.16, ease: "power3.in" }, {{ d - 0.16 }});
{%- elif kind == 'flash' -%}
      tl.to("#{{ flash_id }}", { opacity: 1, duration: 0.12, ease: "power2.in" }, {{ d - 0.12 }});
{%- endif -%}
{%- endmacro %}

{#- cursor arrow (inline svg, same shape as the original) -#}
{% macro cursor(cid) -%}
<svg id="{{ cid }}" class="cursor rf-cursor" viewBox="0 0 32 38"><path d="M3 2 L3 31 L10.5 24 L15.5 35 L20.5 32.8 L15.6 22 L26 22 Z" fill="#fff" stroke="{{ T.on_light }}" stroke-width="2.4" stroke-linejoin="round"/></svg>
{%- endmacro %}

