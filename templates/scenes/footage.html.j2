{% import "_lib.j2" as lib with context %}
{#- Footage shot: an ingested clip, full-frame, with a slow push, transitions and motion-graphics overlays.
    s.video: footage id   s.media_start: seconds into the clip   s.fit: cover|contain   s.push: [1.0, 1.08]
    s.audio: default true keeps the clip's own sound; set false to mute. Auto-muted only when this clip is the aroll dialogue source.
    s.lines: [{text: "...[accent]", size: 96}]   s.caption_pos: bottom|middle|center
    s.overlays: [{type: keyword, at, text, icon, side} | {type: stat, at, value, suffix, label} | {type: lowerthird, at, text}]
    s.entry: none|cut|punch|zoom-blur|flash|shake|whip-left|whip-right|push-up|blur   s.exit as in kinetic -#}
{%- set d = s.duration -%}
{%- set push = s.push or [1.0, 1.08] -%}
{%- set pos = s.caption_pos or 'bottom' -%}
{%- set o_top = s.overlay_top -%}  {#- overlays sit in the headroom above the speaker (fraction of height) -#}
<template>
  <style>
    #{{ id }}-root { position: absolute; inset: 0; overflow: hidden; background: {{ T.dark0 }}; }
    #{{ id }}-cam { position: absolute; inset: 0; transform-origin: 50% 40%; }
    #{{ id }}-kb { position: absolute; inset: 0; transform-origin: 50% 32%; }
    #{{ id }}-v { position: absolute; left: 0; top: 0; width: {{ W }}px; height: {{ H }}px; object-fit: {{ s.fit or 'cover' }}; }
    #{{ id }}-scrim { position: absolute; inset: 0; background: {{ 'linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,.72) 100%)' if pos == 'bottom' else ('linear-gradient(180deg, rgba(0,0,0,0) 38%, rgba(0,0,0,.55) 62%, rgba(0,0,0,.2) 85%)' if pos == 'middle' else 'rgba(0,0,0,.35)') }}; }
    #{{ id }}-cap { position: absolute; left: 0; right: 0; {{ ('bottom: ' ~ (110*u)|round ~ 'px') if pos == 'bottom' else ('top: ' ~ (H*0.56)|round ~ 'px' if pos == 'middle' else 'top: 50%; transform: translateY(-50%)') }}; display: flex; flex-direction: column; align-items: center; gap: {{ (10*u)|round }}px; }
    #{{ id }}-root .kl { font-family: {{ T.font_display }};{% if T.display_upper %} text-transform: uppercase;{% endif %}  max-width: {{ (W*0.88)|round }}px; text-align: center; font-weight: 700; letter-spacing: -0.04em; line-height: 1.04; color: {{ T.on_dark }}; text-shadow: 0 6px 30px rgba(0,0,0,.45); }
    #{{ id }}-root .kl .w { display: inline-block; margin-right: 0.2em; }
    #{{ id }}-root .kl .w:last-child { margin-right: 0; }
    #{{ id }}-root .kl .acc { text-shadow: none; }
    /* keyword pop-up: pill word + clay icon tile */
    #{{ id }}-root .kw { position: absolute; top: {{ (H*(o_top or 0.12))|round }}px; display: flex; align-items: center; gap: {{ (18*u)|round }}px; }
    #{{ id }}-root .kw.right { right: {{ (60*u)|round }}px; flex-direction: row-reverse; }
    #{{ id }}-root .kw.left { left: {{ (60*u)|round }}px; }
    #{{ id }}-root .kw .pill { font-family: {{ T.font_display }};{% if T.display_upper %} text-transform: uppercase;{% endif %}  font-size: {{ (62*u)|round }}px; font-weight: 700; letter-spacing: -0.03em; padding: 0.06em 0.42em 0.12em; border-radius: 999px; }
    #{{ id }}-root .kw .tile { width: {{ (120*u)|round }}px; height: {{ (120*u)|round }}px; border-radius: 30%; display: grid; place-items: center; flex: none; }
    #{{ id }}-root .kw .tile svg { width: 54%; height: 54%; fill: none; stroke: currentColor; stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; }
    #{{ id }}-root .kw .emo { font-size: {{ (104*u)|round }}px; line-height: 1; flex: none; filter: drop-shadow(0 {{ (4*u)|round }}px {{ (10*u)|round }}px rgba(0,0,0,.35)); }
    /* stat card */
    #{{ id }}-root .st { position: absolute; left: 50%; top: {{ (H*((o_top or 0.12) - 0.03))|round }}px; transform: translateX(-50%); padding: {{ (26*u)|round }}px {{ (52*u)|round }}px; border-radius: {{ (40*u)|round }}px; text-align: center; }
    #{{ id }}-root .st .n { font-family: {{ T.font_display }};{% if T.display_upper %} text-transform: uppercase;{% endif %}  font-size: {{ (150*u)|round }}px; font-weight: 700; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
    #{{ id }}-root .st .l { margin-top: {{ (6*u)|round }}px; font-size: {{ (32*u)|round }}px; font-weight: 700; letter-spacing: 0.08em; color: {{ T.on_dark_2 }}; }
    /* lower third */
    #{{ id }}-root .lt { position: absolute; left: {{ (60*u)|round }}px; top: {{ (H*0.62)|round }}px; display: flex; align-items: center; gap: {{ (16*u)|round }}px; padding: {{ (16*u)|round }}px {{ (30*u)|round }}px; border-radius: 999px; font-size: {{ (36*u)|round }}px; font-weight: 700; color: {{ T.on_dark }}; background: rgba(20,20,22,.82); }
    #{{ id }}-root .lt i { width: {{ (14*u)|round }}px; height: {{ (14*u)|round }}px; border-radius: 50%; background: {{ T.on_dark }}; }
    #{{ id }}-flash { position: absolute; inset: 0; background: {{ T.paper }}; opacity: 0; pointer-events: none; }
  </style>
  <div id="{{ id }}-root" data-composition-id="{{ id }}" data-width="{{ W }}" data-height="{{ H }}" data-layout-allow-overlap>
    <div id="{{ id }}-cam" data-layout-allow-overflow>
      <div id="{{ id }}-kb" data-layout-allow-overflow>
        <video id="{{ id }}-v" class="clip" src="assets/footage/{{ s.video }}.mp4" data-start="0" data-duration="{{ d }}" data-media-start="{{ s.media_start or 0 }}" data-track-index="1" {% if s.audio %}data-has-audio="true"{% else %}muted{% endif %} playsinline{% if G %} data-color-grading='{{ G|tojson }}'{% endif %}></video>
      </div>
      {%- if s.lines %}
      <div id="{{ id }}-scrim" data-layout-ignore></div>
      <div id="{{ id }}-cap">
        {%- for l in s.lines %}
        <p class="kl" id="{{ id }}-l{{ loop.index0 }}" style="font-size:{{ ((l.size or 96)*u)|round }}px">{{ lib.words(l.text, true) }}</p>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
    {%- for o in (s.overlays or []) %}
    {%- if o.type == 'keyword' %}
    <div class="kw {{ o.side or 'right' }}" id="{{ id }}-o{{ loop.index0 }}">
      {%- if o.emoji %}<div class="emo" id="{{ id }}-o{{ loop.index0 }}t">{{ o.emoji }}</div>{% elif o.icon %}<div class="tile clay clay--dark" id="{{ id }}-o{{ loop.index0 }}t">{{ lib.glyph(o.icon) }}</div>{% endif %}
      <span class="pill acc" id="{{ id }}-o{{ loop.index0 }}p">{{ o.text }}</span>
    </div>
    {%- elif o.type == 'stat' %}
    <div class="st clay clay--dark" id="{{ id }}-o{{ loop.index0 }}"><div class="n"><span id="{{ id }}-o{{ loop.index0 }}n">0</span>{{ o.suffix }}</div>{% if o.label %}<div class="l">{{ o.label }}</div>{% endif %}</div>
    {%- elif o.type == 'lowerthird' %}
    <div class="lt" id="{{ id }}-o{{ loop.index0 }}"><i></i>{{ o.text }}</div>
    {%- endif %}
    {%- endfor %}
    <div id="{{ id }}-flash"></div>
  </div>
  <script>
    (function () {
      const tl = gsap.timeline({ paused: true });
{{ lib.entry_js(s.entry or 'blur', id ~ '-cam', id ~ '-flash') }}
      tl.fromTo("#{{ id }}-kb", { scale: {{ push[0] }} }, { scale: {{ push[1] }}, duration: {{ d }}, ease: "none" }, 0);
      {%- for l in (s.lines or []) %}
      {%- if has_plain(l.text) %}
      tl.fromTo("#{{ id }}-l{{ loop.index0 }} .w:not(.acc)", { opacity: 0, y: {{ (30*u)|round }}, filter: "blur(12px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.2, stagger: 0.06, ease: "power3.out" }, {{ 0.15 + loop.index0 * 0.22 }});
      {%- endif %}{% if '[' in l.text %}
      tl.fromTo("#{{ id }}-l{{ loop.index0 }} .acc", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.32, ease: "back.out(2.2)" }, {{ 0.35 + loop.index0 * 0.22 }});
      {%- endif %}{%- if '[' in l.text %}{{ cue('pop', s.start + 0.4 + loop.index0 * 0.22, 0.6) }}{% endif %}
      {%- endfor %}
      {%- if s.lines and d > 2.0 %}
      tl.to("#{{ id }}-cap, #{{ id }}-scrim", { opacity: 0, y: {{ (-20*u)|round }}, duration: 0.22, ease: "power2.in" }, {{ d - 0.3 }});
      {%- endif %}
      {%- for o in (s.overlays or []) %}{% set oid = id ~ '-o' ~ loop.index0 %}{% set t = [o.at, 0.05]|max %}{% set hold = [1.25, d - t - 0.25]|min %}
      {%- if o.type == 'keyword' %}{% set dx = (-1 if o.side == 'left' else 1) * 60 * u %}
      tl.fromTo("#{{ oid }}", { opacity: 0, x: {{ dx|round }} }, { opacity: 1, x: 0, duration: 0.28, ease: "back.out(1.8)" }, {{ t }});
      {%- if o.icon or o.emoji %}
      tl.fromTo("#{{ oid }}t", { scale: 0.3, rotation: {{ -14 if o.side == 'left' else 14 }} }, { scale: 1, rotation: {{ -6 if o.side == 'left' else 6 }}, duration: 0.4, ease: "back.out(2.4)" }, {{ t + 0.05 }});
      {%- endif %}
      tl.fromTo("#{{ oid }}p", { scale: 0.6 }, { scale: 1, duration: 0.32, ease: "back.out(2.2)" }, {{ t + 0.08 }});
      tl.to("#{{ oid }}", { opacity: 0, x: {{ (dx * 0.5)|round }}, filter: "blur(8px)", duration: 0.2, ease: "power2.in" }, {{ t + hold }});
      {{- cue('pop-hi', s.start + t + 0.1, 0.55) }}
      {%- elif o.type == 'stat' %}
      const c{{ loop.index0 }} = { v: 0 };
      const pc{{ loop.index0 }} = () => { document.getElementById("{{ oid }}n").textContent = Math.round(c{{ loop.index0 }}.v); };
      tl.fromTo("#{{ oid }}", { opacity: 0, scale: 0.6, y: {{ (40*u)|round }} }, { opacity: 1, scale: 1, y: 0, duration: 0.35, ease: "back.out(1.8)" }, {{ t }});
      tl.fromTo(c{{ loop.index0 }}, { v: 0 }, { v: {{ o.value }}, duration: 0.7, ease: "power2.out", onUpdate: pc{{ loop.index0 }}, onComplete: pc{{ loop.index0 }}, immediateRender: true }, {{ t + 0.1 }});
      tl.to("#{{ oid }}", { opacity: 0, scale: 0.9, filter: "blur(8px)", duration: 0.2, ease: "power2.in" }, {{ t + [1.6, d - t - 0.25]|min }});
      {{- cue('pop', s.start + t + 0.12, 0.6) }}{{ cue('ping', s.start + t + 0.8, 0.35) }}
      {%- elif o.type == 'lowerthird' %}
      tl.fromTo("#{{ oid }}", { opacity: 0, x: {{ (-80*u)|round }} }, { opacity: 1, x: 0, duration: 0.35, ease: "expo.out" }, {{ t }});
      tl.to("#{{ oid }}", { opacity: 0, x: {{ (-40*u)|round }}, duration: 0.25, ease: "power2.in" }, {{ t + [2.4, d - t - 0.3]|min }});
      {{- cue('whoosh-short', s.start + t, 0.3) }}
      {%- endif %}
      {%- endfor %}
{{ lib.exit_js(s.exit or 'none', id ~ '-cam', id ~ '-flash', d) }}
      window.__timelines["{{ id }}"] = tl;
    })();
  </script>
</template>
